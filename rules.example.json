{
  "version": 1,
  "settings": {
    "target_root": "",
    "archive_output_root": "",
    "vault_path": "",
    "password_module_enabled": true,
    "delete_archive_after_verify": false,
    "cleanup_empty": true,
    "recursion": "full",
    "ignore_ds_store": true
  },
  "rules": [
    {
      "id": "builtin.archive.extract",
      "name": "自动解压（CRC 校验）",
      "enabled": true,
      "priority": 1,
      "match_mode": "any",
      "conditions": [
        {
          "type": "extension",
          "values": [
            "zip",
            "rar",
            "7z",
            "tar",
            "gz",
            "bz2",
            "xz",
            "tgz"
          ]
        }
      ],
      "actions": [
        {
          "type": "extract",
          "target": "",
          "delete_original": false,
          "password_module": true
        },
        {
          "type": "cleanup_empty"
        }
      ],
      "stop_on_match": true,
      "notes": "内置解压插件：复用 archive-auto-extractor 的 CRC 三重校验与密码库"
    },
    {
      "id": "builtin.classify.图片",
      "name": "自动分类：图片",
      "enabled": true,
      "priority": 10,
      "match_mode": "any",
      "conditions": [
        {
          "type": "extension",
          "values": [
            "jpg",
            "jpeg",
            "png",
            "gif",
            "webp",
            "heic",
            "tiff",
            "bmp",
            "svg",
            "raw",
            "cr2",
            "nef"
          ]
        }
      ],
      "actions": [
        {
          "type": "move",
          "target": "图片",
          "conflict": "rename",
          "verify": false
        }
      ],
      "stop_on_match": true,
      "notes": "内置分类插件：12 种扩展名 → 图片/"
    },
    {
      "id": "builtin.classify.视频",
      "name": "自动分类：视频",
      "enabled": true,
      "priority": 11,
      "match_mode": "any",
      "conditions": [
        {
          "type": "extension",
          "values": [
            "mp4",
            "mkv",
            "avi",
            "mov",
            "wmv",
            "flv",
            "webm",
            "m4v",
            "ts",
            "mpg",
            "mpeg"
          ]
        }
      ],
      "actions": [
        {
          "type": "move",
          "target": "视频",
          "conflict": "rename",
          "verify": false
        }
      ],
      "stop_on_match": true,
      "notes": "内置分类插件：11 种扩展名 → 视频/"
    },
    {
      "id": "builtin.classify.音频",
      "name": "自动分类：音频",
      "enabled": true,
      "priority": 12,
      "match_mode": "any",
      "conditions": [
        {
          "type": "extension",
          "values": [
            "mp3",
            "flac",
            "wav",
            "aac",
            "m4a",
            "ogg",
            "wma",
            "opus",
            "aiff"
          ]
        }
      ],
      "actions": [
        {
          "type": "move",
          "target": "音频",
          "conflict": "rename",
          "verify": false
        }
      ],
      "stop_on_match": true,
      "notes": "内置分类插件：9 种扩展名 → 音频/"
